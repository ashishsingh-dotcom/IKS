 c.forEach(function(x){var b=document.createElement('button');b.className='mc';b.textContent='?';b.onclick=function(){if(b.classList.contains('up')||b.classList.contains('done')||open_.length>1)return;b.textContent=x[1];b.classList.add('up');open_.push([b,x[0]]);
  if(open_.length==2){mvs++;var a=open_[0],d=open_[1];setTimeout(function(){if(a[1]==d[1]){a[0].className=d[0].className='mc done';done++;if(done==4){mm.textContent='Complete in '+mvs+' moves!';xp(100,'Bonus cleared +100 XP');ach('Memory Master')}}else{a[0].className=d[0].className='mc';a[0].textContent=d[0].textContent='?'}open_=[]},700)}};M.appendChild(b)})}
