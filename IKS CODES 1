 var q=Q[qi];qz.innerHTML='<div class="boss"><span>Mahabalasura</span><div class="hp"><i style="width:'+(100-sc/Q.length*100)+'%"></i></div></div><p>Question '+(qi+1)+' of '+Q.length+'</p><h3 style="color:inherit">'+q[0]+'</h3>';
 q[1].forEach(function(o,i){var b=document.createElement('button');b.className='opt';b.textContent=o;b.onclick=function(){
  qz.querySelectorAll('.opt').forEach(function(x,j){x.disabled=true;if(j==q[2])x.classList.add('ok')});
