function xp(n,m){var o=Math.floor(XP/150);XP+=n;var l=Math.floor(XP/150);document.getElementById('lv').textContent='LVL '+(l+1);document.getElementById('xb').style.width=(XP%150)/150*100+'%';document.getElementById('xt').textContent=XP+' XP';toast(l>o?'LEVEL UP! You are level '+(l+1):m||'+'+n+' XP')}
