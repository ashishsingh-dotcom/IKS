 if(k=='pad'){for(var j=0;j<3;j++){for(var i=0;i<8;i++){var a=i/8*6.283+j*.39,r=45+j*40,x=150+r*Math.cos(a),y=150+r*Math.sin(a);s+='<ellipse cx="'+x.toFixed(1)+'" cy="'+y.toFixed(1)+'" rx="22" ry="11" transform="rotate('+(a*57.3).toFixed(0)+' '+x.toFixed(1)+' '+y.toFixed(1)+')" fill="'+(j%2?'#e63946':'#9a9a9a')+'" opacity=".85"/>'}}s+='<circle cx="150" cy="150" r="14" fill="#c0392b"/>'}
 if(k=='garuda'){var p=[[150,40],[135,70],[165,70],[150,100],[150,130],[150,160],[150,190],[150,220],[150,250],[120,100],[90,85],[60,70],[30,55],[180,100],[210,85],[240,70],[270,55],[135,250],[165,250],[150,270]];p.forEach(function(q,i){s+='<circle cx="'+q[0]+'" cy="'+q[1]+'" r="8" fill="'+(i<3?'#ffffff':i<9?'#9a9a9a':'#e63946')+'"/>'});s+='<text x="150" y="26" font-size="11" text-anchor="middle" fill="#888">beak</text>'}
 S.innerHTML=s;document.getElementById('vt').textContent=v.t;document.getElementById('vd').textContent=v.d;document.getElementById('vm').textContent=v.m;
 document.querySelectorAll('.tabs button').forEach(function(b){b.setAttribute('aria-pressed',b.dataset.v==k)})}
document.querySelectorAll('.tabs button').forEach(function(b){b.onclick=function(){show(b.dataset.v)}});
