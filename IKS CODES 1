garuda:{t:'Garudavyuha (eagle formation)',d:'Soldiers arranged like an eagle with a beak, two wings and a tail. The beak strikes first while the wings flank.',m:'Modern link: spearhead and flanking manoeuvres in squad-based shooters.'}};
var S=document.getElementById('vsvg'),ns='http://www.w3.org/2000/svg';
