function ckDraw(){var h='',al=rot.every(function(x){return x==rot[0]});
 RR.forEach(function(r,i){var C=2*Math.PI*r;h+='<circle data-i="'+i+'" cx="150" cy="150" r="'+r+'" fill="none" stroke="'+(i%2?'#9a9a9a':'#e63946')+'" stroke-width="16" stroke-dasharray="'+(C*7/8).toFixed(1)+' '+(C/8).toFixed(1)+'" transform="rotate('+rot[i]*45+' 150 150)"/>'});
 h+='<circle cx="150" cy="150" r="20" fill="#fff"/><text x="150" y="154" font-size="10" text-anchor="middle" fill="#000">Raja</text>';
 if(al){var a=(337.5+rot[0]*45)*Math.PI/180;h+='<line x1="'+(150+20*Math.cos(a)).toFixed(1)+'" y1="'+(150+20*Math.sin(a)).toFixed(1)+'" x2="'+(150+145*Math.cos(a)).toFixed(1)+'" y2="'+(150+145*Math.sin(a)).toFixed(1)+'" stroke="#ffd166" stroke-width="5" pointer-events="none"/>'}
 ckS.innerHTML=h;
 if(al&&!ckWon){ckWon=true;ckM.textContent='The path is open! But the legend says Abhimanyu never learned how to leave.';xp(80,'Chakravyuha opened +80 XP');ach('Chakravyuha Breaker')}}
ckS.addEventListener('click',function(e){var i=e.target.dataset.i;if(i==null||ckWon)return;rot[i]=(rot[i]+1)%8;ckDraw()});
